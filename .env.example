# Copy to .env for local runs. .env is gitignored — never commit the real key.
FRED_API_KEY=paste_your_key_here

# Optional. Free from https://www.eia.gov/opendata/register.php
# If set, the build checks whether EIA has a fresher oil print than FRED
# and uses it when it does. Without it, nothing changes.
EIA_API_KEY=

# Optional. Free from https://www.alphavantage.co/support/#api-key
# Checked for a fresher oil print than FRED/EIA. Note that some free oil APIs
# resell the same EIA spot series - the build compares dates and only switches
# if it is genuinely ahead, so a key can never make the data worse.
ALPHAVANTAGE_API_KEY=
